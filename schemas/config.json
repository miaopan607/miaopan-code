{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Config",
  "$defs": {
    "LogLevel": {
      "type": "string",
      "enum": ["DEBUG", "INFO", "WARN", "ERROR"],
      "description": "日志级别"
    },
    "ServerConfig": {
      "type": "object",
      "properties": {
        "port": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991,
          "description": "监听端口"
        },
        "hostname": {
          "type": "string",
          "description": "监听主机名"
        },
        "mdns": {
          "type": "boolean",
          "description": "启用 mDNS 服务发现"
        },
        "mdnsDomain": {
          "type": "string",
          "description": "mDNS 自定义域名（默认：miaopanCode.local）"
        },
        "cors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "允许用于 CORS 的附加域名"
        }
      },
      "additionalProperties": false
    },
    "ConfigV2.Reference.Git": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        }
      },
      "required": ["repository"],
      "additionalProperties": false
    },
    "ConfigV2.Reference.Local": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        }
      },
      "required": ["path"],
      "additionalProperties": false
    },
    "PermissionActionConfig": {
      "type": "string",
      "enum": ["ask", "allow", "deny"]
    },
    "PermissionObjectConfig": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/PermissionActionConfig"
      }
    },
    "PermissionRuleConfig": {
      "anyOf": [
        {
          "$ref": "#/$defs/PermissionActionConfig"
        },
        {
          "$ref": "#/$defs/PermissionObjectConfig"
        }
      ]
    },
    "PermissionConfig": {
      "anyOf": [
        {
          "$ref": "#/$defs/PermissionActionConfig"
        },
        {
          "type": "object",
          "properties": {
            "read": {
              "$ref": "#/$defs/PermissionRuleConfig"
            },
            "edit": {
              "$ref": "#/$defs/PermissionRuleConfig"
            },
            "glob": {
              "$ref": "#/$defs/PermissionRuleConfig"
            },
            "grep": {
              "$ref": "#/$defs/PermissionRuleConfig"
            },
            "list": {
              "$ref": "#/$defs/PermissionRuleConfig"
            },
            "bash": {
              "$ref": "#/$defs/PermissionRuleConfig"
            },
            "task": {
              "$ref": "#/$defs/PermissionRuleConfig"
            },
            "external_directory": {
              "$ref": "#/$defs/PermissionRuleConfig"
            },
            "todowrite": {
              "$ref": "#/$defs/PermissionActionConfig"
            },
            "question": {
              "$ref": "#/$defs/PermissionActionConfig"
            },
            "webfetch": {
              "$ref": "#/$defs/PermissionActionConfig"
            },
            "websearch": {
              "$ref": "#/$defs/PermissionActionConfig"
            },
            "lsp": {
              "$ref": "#/$defs/PermissionRuleConfig"
            },
            "doom_loop": {
              "$ref": "#/$defs/PermissionActionConfig"
            },
            "skill": {
              "$ref": "#/$defs/PermissionRuleConfig"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/PermissionRuleConfig"
          }
        }
      ]
    },
    "AgentConfig": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "$ref": "https://models.dev/model-schema.json#/$defs/Model"
        },
        "variant": {
          "type": "string",
          "description": "格式为 provider/model 的模型，例如 anthropic/claude-2"
        },
        "temperature": {
          "type": "number"
        },
        "top_p": {
          "type": "number"
        },
        "prompt": {
          "type": "string"
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "已弃用：请使用 agent 字段"
        },
        "disable": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "description": "代理配置，参见 docs/agents"
        },
        "mode": {
          "type": "string",
          "enum": ["subagent", "primary", "all"]
        },
        "hidden": {
          "type": "boolean",
          "description": "仅主代理可用的工具"
        },
        "options": {
          "type": "object"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "string",
              "enum": ["primary", "secondary", "accent", "success", "warning", "error", "info"]
            }
          ],
          "description": "代理配置，参见 docs/agents"
        },
        "steps": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991,
          "description": "压缩后逐字保留的最近轮次 Token 最大数量"
        },
        "maxSteps": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991,
          "description": "已弃用：请使用 agent 字段"
        },
        "permission": {
          "$ref": "#/$defs/PermissionConfig"
        }
      }
    },
    "ProviderConfig": {
      "type": "object",
      "properties": {
        "api": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "npm": {
          "type": "string"
        },
        "whitelist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blacklist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "options": {
          "type": "object",
          "properties": {
            "apiKey": {
              "type": "string"
            },
            "baseURL": {
              "type": "string"
            },
            "enterpriseUrl": {
              "type": "string",
              "description": "企业 URL"
            },
            "setCacheKey": {
              "type": "boolean",
              "description": "为 AI SDK 调用启用 OpenTelemetry span（使用 experimental_telemetry 标志）"
            },
            "timeout": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer",
                  "maximum": 9007199254740991
                },
                {
                  "type": "boolean",
                  "enum": [false]
                }
              ],
              "description": "模型上下文协议（MCP）请求的超时时间（毫秒）"
            },
            "headerTimeout": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer",
                  "maximum": 9007199254740991
                },
                {
                  "type": "boolean",
                  "enum": [false]
                }
              ],
              "description": "等待提供商响应标头的超时时间（毫秒）；设为 false 可禁用"
            },
            "chunkTimeout": {
              "exclusiveMinimum": 0,
              "type": "integer",
              "maximum": 9007199254740991,
              "description": "此提供商流式 SSE 分块之间的超时时间（毫秒）"
            }
          }
        },
        "models": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "compaction_model": {
                "type": "string",
                "description": "此模型专用的压缩模型，格式为 provider/model",
                "$ref": "https://models.dev/model-schema.json#/$defs/Model"
              },
              "name": {
                "type": "string"
              },
              "family": {
                "type": "string"
              },
              "release_date": {
                "type": "string"
              },
              "attachment": {
                "type": "boolean"
              },
              "reasoning": {
                "type": "boolean"
              },
              "temperature": {
                "type": "boolean"
              },
              "tool_call": {
                "type": "boolean"
              },
              "interleaved": {
                "anyOf": [
                  {
                    "type": "boolean",
                    "enum": [true]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "enum": ["reasoning", "reasoning_content", "reasoning_details"]
                      }
                    },
                    "required": ["field"],
                    "additionalProperties": false
                  }
                ]
              },
              "cost": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "number"
                  },
                  "output": {
                    "type": "number"
                  },
                  "cache_read": {
                    "type": "number"
                  },
                  "cache_write": {
                    "type": "number"
                  },
                  "context_over_200k": {
                    "type": "object",
                    "properties": {
                      "input": {
                        "type": "number"
                      },
                      "output": {
                        "type": "number"
                      },
                      "cache_read": {
                        "type": "number"
                      },
                      "cache_write": {
                        "type": "number"
                      }
                    },
                    "required": ["input", "output"],
                    "additionalProperties": false
                  }
                },
                "required": ["input", "output"],
                "additionalProperties": false
              },
              "limit": {
                "type": "object",
                "properties": {
                  "context": {
                    "type": "number"
                  },
                  "input": {
                    "type": "number"
                  },
                  "output": {
                    "type": "number"
                  }
                },
                "required": ["context", "output"],
                "additionalProperties": false
              },
              "modalities": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["text", "audio", "image", "video", "pdf"]
                    }
                  },
                  "output": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["text", "audio", "image", "video", "pdf"]
                    }
                  }
                },
                "additionalProperties": false
              },
              "experimental": {
                "type": "boolean"
              },
              "status": {
                "type": "string",
                "enum": ["alpha", "beta", "deprecated", "active"]
              },
              "provider": {
                "type": "object",
                "properties": {
                  "npm": {
                    "type": "string"
                  },
                  "api": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "options": {
                "type": "object"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "variants": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "disabled": {
                      "type": "boolean",
                      "description": "禁用自动加载的提供商"
                    },
                    "$miaopanCode": {
                      "type": "object",
                      "properties": {
                        "mode": {
                          "type": "string",
                          "enum": ["ultra"]
                        }
                      },
                      "required": ["mode"],
                      "additionalProperties": false
                    }
                  }
                },
                "description": "自定义提供商配置和模型覆盖项"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "McpLocalConfig": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["local"],
          "description": "MCP 服务器连接类型"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "运行 MCP 服务器的命令和参数"
        },
        "cwd": {
          "type": "string",
          "description": "MCP 服务器进程的工作目录；相对路径相对于工作区目录"
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "运行 MCP 服务器时设置的环境变量"
        },
        "enabled": {
          "type": "boolean",
          "description": "启动时启用或禁用 MCP 服务器"
        },
        "timeout": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991,
          "description": "MCP 服务器请求超时时间（毫秒），未指定时默认为 5000（5 秒）"
        }
      },
      "required": ["type", "command"],
      "additionalProperties": false
    },
    "McpOAuthConfig": {
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "description": "OAuth 客户端 ID；未提供时将尝试动态客户端注册（RFC 7591）"
        },
        "clientSecret": {
          "type": "string",
          "description": "OAuth 客户端密钥（授权服务器需要时）"
        },
        "scope": {
          "type": "string",
          "description": "授权期间请求的 OAuth 作用域"
        },
        "callbackPort": {
          "minimum": 1,
          "maximum": 65535,
          "type": "integer",
          "description": "本地 OAuth 回调服务器端口（默认：19876）"
        },
        "redirectUri": {
          "type": "string",
          "description": "OAuth 重定向 URI（默认：http://127.0.0.1:19876/mcp/oauth/callback）"
        }
      },
      "additionalProperties": false
    },
    "McpRemoteConfig": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["remote"],
          "description": "MCP 服务器连接类型"
        },
        "url": {
          "type": "string",
          "description": "远程 MCP 服务器 URL"
        },
        "enabled": {
          "type": "boolean",
          "description": "启动时启用或禁用 MCP 服务器"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "随请求发送的标头"
        },
        "oauth": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpOAuthConfig"
            },
            {
              "type": "boolean",
              "enum": [false]
            }
          ],
          "description": "MCP 服务器的 OAuth 身份验证配置；设为 false 可禁用 OAuth 自动检测"
        },
        "timeout": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991,
          "description": "MCP 服务器请求超时时间（毫秒），未指定时默认为 5000（5 秒）"
        }
      },
      "required": ["type", "url"],
      "additionalProperties": false
    },
    "LayoutConfig": {
      "type": "string",
      "enum": ["auto", "stretch"]
    },
    "ImageAttachmentConfig": {
      "type": "object",
      "properties": {
        "auto_resize": {
          "type": "boolean",
          "description": "图像超过配置限制时在发送给模型前调整大小（默认：true）"
        },
        "max_width": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991,
          "description": "调整大小或拒绝附件前的最大图像宽度（默认：2000）"
        },
        "max_height": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991,
          "description": "调整大小或拒绝附件前的最大图像高度（默认：2000）"
        },
        "max_base64_bytes": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991,
          "description": "图像附件的最大 base64 负载字节数（默认：5242880）"
        }
      },
      "additionalProperties": false
    },
    "AttachmentConfig": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/$defs/ImageAttachmentConfig",
          "description": "图像附件配置"
        }
      },
      "additionalProperties": false
    },
    "Config.RetryCategory": {
      "type": "string",
      "enum": ["network", "timeout", "response", "validation", "rate_limit", "forbidden", "server", "unknown"]
    },
    "Config.Retry": {
      "type": "object",
      "properties": {
        "stream_max_retries": {
          "minimum": 0,
          "description": "流阶段在首次请求之外最多自动重试的次数（默认：10）",
          "type": "integer",
          "maximum": 9007199254740991
        },
        "stream_initial_delay_ms": {
          "minimum": 0,
          "description": "流阶段第一次重试的本地退避间隔（毫秒，默认：200）",
          "type": "integer",
          "maximum": 9007199254740991
        },
        "stream_backoff_factor": {
          "minimum": 1,
          "description": "流阶段每次重试的退避倍数（最小值：1，默认：2）",
          "type": "number"
        },
        "stream_max_delay_ms": {
          "minimum": 0,
          "description": "流阶段本地指数退避的最大间隔（毫秒，默认：3200）",
          "type": "integer",
          "maximum": 9007199254740991
        },
        "stream_jitter_percent": {
          "minimum": 0,
          "maximum": 100,
          "description": "流阶段退避的均匀抖动百分比（0 至 100，默认：10）",
          "type": "number"
        },
        "http_max_retries": {
          "minimum": 0,
          "description": "HTTP 阶段在首次请求之外最多自动重试的次数（默认：10）",
          "type": "integer",
          "maximum": 9007199254740991
        },
        "http_initial_delay_ms": {
          "minimum": 0,
          "description": "HTTP 阶段第一次重试的本地退避间隔（毫秒，默认：200）",
          "type": "integer",
          "maximum": 9007199254740991
        },
        "http_backoff_factor": {
          "minimum": 1,
          "description": "HTTP 阶段每次重试的退避倍数（最小值：1，默认：2）",
          "type": "number"
        },
        "http_max_delay_ms": {
          "minimum": 0,
          "description": "HTTP 阶段本地指数退避的最大间隔（毫秒，默认：1600）",
          "type": "integer",
          "maximum": 9007199254740991
        },
        "http_jitter_percent": {
          "minimum": 0,
          "maximum": 100,
          "description": "HTTP 阶段退避的均匀抖动百分比（0 至 100，默认：10）",
          "type": "number"
        },
        "respect_retry_after": {
          "type": "boolean",
          "description": "是否优先使用 Provider 返回的 Retry-After 间隔（默认：true）"
        },
        "retry_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Config.RetryCategory"
          },
          "description": "启用自动重试的错误类别；未配置时启用全部默认类别"
        }
      },
      "additionalProperties": false
    },
    "Policy.Effect": {
      "type": "string",
      "enum": ["allow", "deny"]
    },
    "ConfigV2.Experimental.Policy": {
      "type": "object",
      "properties": {
        "action": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string",
                  "enum": ["provider.use"]
                }
              ]
            }
          ]
        },
        "effect": {
          "$ref": "#/$defs/Policy.Effect"
        },
        "resource": {
          "type": "string"
        }
      },
      "required": ["action", "effect", "resource"],
      "additionalProperties": false
    },
    "Config": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "用于配置验证的 JSON Schema 引用"
        },
        "language": {
          "type": "string",
          "enum": ["zh-CN", "en"],
          "description": "界面、内建工具和模型提示使用的语言；默认为 zh-CN"
        },
        "shell": {
          "type": "string",
          "description": "终端和 shell 工具执行时使用的默认 shell"
        },
        "logLevel": {
          "$ref": "#/$defs/LogLevel",
          "description": "日志级别"
        },
        "server": {
          "$ref": "#/$defs/ServerConfig",
          "description": "miaopan-code serve 和 web 命令的服务器配置"
        },
        "command": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "template": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "agent": {
                "type": "string"
              },
              "model": {
                "type": "string",
                "$ref": "https://models.dev/model-schema.json#/$defs/Model"
              },
              "variant": {
                "type": "string"
              },
              "subtask": {
                "type": "boolean"
              }
            },
            "required": ["template"],
            "additionalProperties": false
          },
          "description": "命令配置，参见 docs/commands"
        },
        "skills": {
          "type": "object",
          "properties": {
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "技能文件夹的附加路径"
            },
            "urls": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "用于获取技能的 URL（例如 https://example.com/.well-known/skills/）"
            }
          },
          "additionalProperties": false,
          "description": "附加技能文件夹路径"
        },
        "references": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/ConfigV2.Reference.Git"
              },
              {
                "$ref": "#/$defs/ConfigV2.Reference.Local"
              }
            ]
          },
          "description": "命名的 Git 或本地目录引用"
        },
        "reference": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/ConfigV2.Reference.Git"
              },
              {
                "$ref": "#/$defs/ConfigV2.Reference.Local"
              }
            ]
          },
          "description": "已弃用：请使用 references 字段。命名的 Git 或本地目录引用"
        },
        "watcher": {
          "type": "object",
          "properties": {
            "ignore": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "snapshot": {
          "type": "boolean",
          "description": "启用或禁用快照跟踪；禁用时不记录文件系统快照"
        },
        "plugin": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object"
                  }
                ],
                "maxItems": 2,
                "minItems": 2
              }
            ]
          }
        },
        "share": {
          "type": "string",
          "enum": ["manual", "auto", "disabled"],
          "description": "控制分享行为：manual 手动分享，auto 自动分享，disabled 禁用分享"
        },
        "autoshare": {
          "type": "boolean",
          "description": "自动分享新创建的会话"
        },
        "autoupdate": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": ["notify"]
            }
          ],
          "description": "自动更新到最新版本；true 自动更新，false 禁用，notify 显示更新通知"
        },
        "disabled_providers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "禁用自动加载的提供商"
        },
        "enabled_providers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "设置后仅启用这些提供商，其他提供商将被忽略"
        },
        "model": {
          "type": "string",
          "description": "格式为 provider/model 的模型，例如 anthropic/claude-2",
          "$ref": "https://models.dev/model-schema.json#/$defs/Model"
        },
        "review_mode": {
          "type": "string",
          "enum": ["codex", "opencode"],
          "description": "内建 /review 命令使用的审查后端；默认为 codex，也可设为 opencode"
        },
        "small_model": {
          "type": "string",
          "description": "用于标题生成等任务的小模型，格式为 provider/model",
          "$ref": "https://models.dev/model-schema.json#/$defs/Model"
        },
        "default_agent": {
          "type": "string",
          "description": "未指定时使用的默认代理，必须是主代理"
        },
        "username": {
          "type": "string",
          "description": "对话中显示的自定义用户名（替代系统用户名）"
        },
        "mode": {
          "type": "object",
          "properties": {
            "build": {
              "$ref": "#/$defs/AgentConfig"
            },
            "ask": {
              "$ref": "#/$defs/AgentConfig"
            },
            "plan": {
              "$ref": "#/$defs/AgentConfig"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/AgentConfig"
          },
          "description": "已弃用：请使用 agent 字段"
        },
        "agent": {
          "type": "object",
          "properties": {
            "plan": {
              "$ref": "#/$defs/AgentConfig"
            },
            "build": {
              "$ref": "#/$defs/AgentConfig"
            },
            "ask": {
              "$ref": "#/$defs/AgentConfig"
            },
            "general": {
              "$ref": "#/$defs/AgentConfig"
            },
            "explore": {
              "$ref": "#/$defs/AgentConfig"
            },
            "title": {
              "$ref": "#/$defs/AgentConfig"
            },
            "summary": {
              "$ref": "#/$defs/AgentConfig"
            },
            "compaction": {
              "$ref": "#/$defs/AgentConfig"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/AgentConfig"
          },
          "description": "代理配置，参见 docs/agents"
        },
        "provider": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ProviderConfig"
          },
          "description": "自定义提供商配置和模型覆盖项"
        },
        "mcp": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "$ref": "#/$defs/McpLocalConfig"
                  },
                  {
                    "$ref": "#/$defs/McpRemoteConfig"
                  }
                ]
              },
              {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  }
                },
                "required": ["enabled"],
                "additionalProperties": false
              }
            ]
          },
          "description": "MCP（Model Context Protocol）服务器配置"
        },
        "formatter": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "disabled": {
                    "type": "boolean"
                  },
                  "command": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "environment": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "extensions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          ],
          "description": "启用或配置格式化程序"
        },
        "lsp": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "disabled": {
                        "type": "boolean",
                        "enum": [true]
                      }
                    },
                    "required": ["disabled"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "command": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "extensions": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "disabled": {
                        "type": "boolean"
                      },
                      "env": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        }
                      },
                      "initialization": {
                        "type": "object"
                      }
                    },
                    "required": ["command"],
                    "additionalProperties": false
                  }
                ]
              }
            }
          ],
          "description": "启用或配置 LSP 服务器"
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "要包含的附加指令文件或模式"
        },
        "question": {
          "type": "object",
          "properties": {
            "auto_resolution": {
              "type": "boolean",
              "description": "允许提问工具在指定等待时间后自动提交空答案（默认：true）"
            }
          },
          "additionalProperties": false
        },
        "layout": {
          "$ref": "#/$defs/LayoutConfig",
          "description": "已弃用：始终使用 stretch 布局"
        },
        "permission": {
          "$ref": "#/$defs/PermissionConfig"
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "attachment": {
          "$ref": "#/$defs/AttachmentConfig",
          "description": "附件处理配置，包括图像大小限制和调整行为"
        },
        "enterprise": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "企业 URL"
            }
          },
          "additionalProperties": false
        },
        "tool_output": {
          "type": "object",
          "properties": {
            "max_lines": {
              "exclusiveMinimum": 0,
              "type": "integer",
              "maximum": 9007199254740991,
              "description": "工具输出截断并保存到磁盘前的最大行数（默认：2000）"
            },
            "max_bytes": {
              "exclusiveMinimum": 0,
              "type": "integer",
              "maximum": 9007199254740991,
              "description": "工具输出截断并保存到磁盘前的最大字节数（默认：51200）"
            }
          },
          "additionalProperties": false,
          "description": "工具输出截断阈值，超出限制时保存完整文本并返回预览"
        },
        "compaction": {
          "type": "object",
          "properties": {
            "auto": {
              "type": "boolean",
              "description": "上下文已满时启用自动压缩（默认：true）"
            },
            "prune": {
              "type": "boolean",
              "description": "启用旧工具输出清理（默认：false）"
            },
            "tail_turns": {
              "minimum": 0,
              "type": "integer",
              "maximum": 9007199254740991,
              "description": "压缩期间逐字保留的最近用户轮次数（默认：2）"
            },
            "preserve_recent_tokens": {
              "minimum": 0,
              "type": "integer",
              "maximum": 9007199254740991,
              "description": "压缩后逐字保留的最近轮次 Token 最大数量"
            },
            "preserve_brief_history": {
              "type": "boolean",
              "description": "压缩后在模型摘要之外保留每轮用户原始输入、助手最终输出和修改文件列表（默认：false）"
            },
            "reserved": {
              "minimum": 0,
              "type": "integer",
              "maximum": 9007199254740991,
              "description": "压缩 Token 缓冲区，为避免溢出预留足够窗口"
            }
          },
          "additionalProperties": false
        },
        "retry": {
          "$ref": "#/$defs/Config.Retry",
          "description": "模型请求的 HTTP 与流重试策略"
        },
        "experimental": {
          "type": "object",
          "properties": {
            "disable_paste_summary": {
              "type": "boolean"
            },
            "batch_tool": {
              "type": "boolean",
              "description": "启用批处理工具"
            },
            "openTelemetry": {
              "type": "boolean",
              "description": "为 AI SDK 调用启用 OpenTelemetry span（使用 experimental_telemetry 标志）"
            },
            "primary_tools": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "仅主代理可用的工具"
            },
            "continue_loop_on_deny": {
              "type": "boolean",
              "description": "工具调用被拒绝时继续代理循环"
            },
            "mcp_timeout": {
              "exclusiveMinimum": 0,
              "type": "integer",
              "maximum": 9007199254740991,
              "description": "模型上下文协议（MCP）请求的超时时间（毫秒）"
            },
            "policies": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ConfigV2.Experimental.Policy"
              },
              "description": "应用于受支持资源（例如提供商访问）的策略声明"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "allowComments": true,
  "allowTrailingCommas": true
}
