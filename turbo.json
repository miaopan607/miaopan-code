{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI", "MIAOPAN_CODE_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "MIAOPAN_CODE_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "miaopan-code#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["*"]
    },
    "@miaopan-code/core#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
  }
}
